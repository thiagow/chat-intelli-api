NODE_ENV=development
PORT=3001

# URL pública desta própria API (usada em channels.service.ts)
APP_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://bravy:bravy123@localhost:5432/chat_bullq

# JWT
JWT_SECRET=change-me-generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-another-different-one
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" for managed Redis providers that require TLS (e.g. Upstash)
REDIS_TLS=false

# CORS
CORS_ORIGIN=http://localhost:3000

# File storage: leave R2_* empty to use local disk (uploads/, dev default).
# Set all four to switch to Cloudflare R2 (needed in production — local disk
# doesn't survive redeploys/multi-instance).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL files are served from: either the bucket's r2.dev domain or a
# custom domain you attached to it.
R2_PUBLIC_URL=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bravy.com

OPENAI_API_KEY=sk-proj-your-key-here

# Sakana LLM (Fugu / Fugu Ultra)
SAKANA_API_KEY=sk-sakana-your-key-here
SAKANA_BASE_URL=https://api.sakana.ai/v1
SAKANA_TIMEOUT_MS=120000

# Google OAuth App (canal GMAIL — um app pra todas as caixas; o
# refresh_token de cada caixa fica em Channel.config)
# Scopes: gmail.readonly + gmail.send + gmail.modify
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Poller do canal GMAIL (cron BullMQ)
GMAIL_POLL_PATTERN=*/1 * * * *
GMAIL_INITIAL_LOOKBACK_HOURS=24
# Teto de emails por caixa no backfill inicial (default 100)
GMAIL_INITIAL_BACKFILL_MAX=100
